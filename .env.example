# Copiar a .env para correr en local. En Railway van como variables del servicio. Sin valores reales acá.
PORT=8080
RUST_LOG=info
DATABASE_URL=postgres://td:td@localhost:55432/task_dashboard   # obligatoria; en Railway la inyecta el servicio Postgres
# syntroAuth (obligatorias). Tienen que coincidir con Jwt:Issuer / Jwt:Audience del syntroAuth
# desplegado, que debe firmar RS256 (Jwt:PrivateKeyPath): sin JWKS, /api da 503.
SYNTROAUTH_ISSUER=SyntroAuth
SYNTROAUTH_AUDIENCE=SyntroAuth
SYNTROAUTH_JWKS_URL=https://<syntroauth>.up.railway.app/.well-known/jwks.json
